# Jira Configuration
JIRA_BASE_URL=https://your-jira-instance.com
JIRA_PAT=your_personal_access_token_here

# Repository Configuration  
REPO_ROOT=/path/to/your/code/repository

# Optional: Logs Directory (improves analysis quality)
LOGS_DIR=/path/to/your/logs

# Optional: Cursor API Key (enables AI analysis)
CURSOR_API_KEY=your_cursor_api_key_here

# Webhook Settings (optional)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_AUTO_ATTACH=false
WEBHOOK_ALLOW_OPEN=false

# Logging Configuration (NEW)
WEBHOOK_LOG_LEVEL=INFO
WEBHOOK_LOG_FILE=logs/webhook.log
AUTH_LOG_LEVEL=INFO
AUTH_LOG_FILE=logs/auth.log
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/app.log
DEBUG_LOG_PATH=logs/debug.log
DEBUG_SESSION_ID=webhook-session