# Required (do not commit your real token)
# Jira source:
# - auto: REST primary, MCP fallback
# - mcp: MCP only
# - api: REST only
JIRA_SOURCE=auto

# MCP (Cursor) primary
JIRA_MCP_SERVER_NAME=mcp-atlassian
# Optional: override Cursor config location
CURSOR_MCP_CONFIG_PATH=

JIRA_BASE_URL=https://jira.telekom.de
JIRA_USER=you@example.com
JIRA_TOKEN=replace-me
# Alternative name some orgs use for Personal Access Tokens:
JIRA_PAT=replace-me
# Jira Server/Data Center often uses PAT as Bearer:
# - basic: Authorization: Basic base64(user:token_or_password)
# - bearer: Authorization: Bearer <token>
# If unset, this project defaults to bearer when `JIRA_PAT` or `JIRA_TOKEN` is set.
# Use JIRA_AUTH_MODE=basic to force Basic auth.
JIRA_AUTH_MODE=

# Optional
# Repo settings
# Default local layout (optional):
# - Codebase folder: jira_triage/Triage-cursor-DB/repo
# - Logs folder: jira_triage/Triage-cursor-DB/logs
# - Outputs: jira_triage/Triage-cursor-DB/out
REPO_ROOT=

OUTPUT_DIR=out
JIRA_API_VERSION=2
JIRA_VERIFY_SSL=true
HTTP_TIMEOUT_SECONDS=30

# Optional logs fetch (stub-friendly)
LOG_API_URL=
LOG_API_METHOD=GET
LOG_API_PARAM_NAME=ticket
LOG_API_VERIFY_SSL=
# Optional logs fallback path (directory OR single file; used if LOG_API_URL is unset/failed)
LOGS_DIR=

# Webhook server (FastAPI)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
# Safety gate: webhook requests with `?open=true` will only open Cursor if this is true.
WEBHOOK_ALLOW_OPEN=false

# Cursor auto-analysis (optional, requires `npm install` in repo root)
# From Cursor Team Settings -> Service accounts
CURSOR_API_KEY=cursor_...
# Optional: override the model used for auto-analysis (defaults to composer-2)
CURSOR_MODEL_ID=composer-2
