# Jira Configuration
JIRA_BASE_URL=https://your-jira-instance.com
JIRA_PAT=your_personal_access_token_here

# Repository Configuration  
REPO_ROOT=/path/to/your/code/repository

# Optional: Logs Directory (improves analysis quality)
LOGS_DIR=/path/to/your/logs

# Optional: Cursor API Key (enables AI analysis)
CURSOR_API_KEY=your_cursor_api_key_here

# Webhook Settings (optional)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_AUTO_ATTACH=false
WEBHOOK_ALLOW_OPEN=false

# Logging Configuration
WEBHOOK_LOG_LEVEL=INFO
WEBHOOK_LOG_FILE=logs/webhook.log
AUTH_LOG_LEVEL=INFO
AUTH_LOG_FILE=logs/auth.log
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/app.log
POLLING_LOG_LEVEL=INFO
POLLING_LOG_FILE=logs/polling.log
DEBUG_LOG_PATH=logs/debug.log
DEBUG_SESSION_ID=webhook-session

# Jira Polling Configuration
JIRA_POLLING_ENABLED=false
JIRA_POLLING_INTERVAL=300
JIRA_POLLING_JQL=assignee = currentUser() AND status != Closed ORDER BY updated DESC
JIRA_POLLING_MAX_RESULTS=50

# Attachment-Based Duplicate Detection (NEW)
JIRA_CHECK_OUR_ATTACHMENTS=true
JIRA_ATTACHMENT_PREFIX=jira-triage-analysis
PROCESSED_TICKETS_DB=data/processed_tickets.db

# Webhook Duplicate Processing Behavior (NEW)
WEBHOOK_SKIP_DUPLICATES=true
WEBHOOK_FORCE_REPROCESS=false

# Magnus API Log Downloading (Optional)
MAGNUS_LOG_API_ENABLED=false
MAGNUS_LOG_API_BASE_URL=https://cms-cdn.yo-digital.com/hgw/magnus
MAGNUS_LOG_API_TOKEN=your_bearer_token_here
# Optional developer overrides
MAGNUS_LOG_MAC=
MAGNUS_LOG_START_DATE=
MAGNUS_LOG_END_DATE=
MAGNUS_AUTO_MERGE_LOGS=true
MAGNUS_MERGE_OUTPUT_DIR=merged