# Required (do not commit your real token)
# Jira source:
# - auto: MCP primary, REST fallback
# - mcp: MCP only
# - api: REST only
JIRA_SOURCE=auto

# MCP (Cursor) primary
JIRA_MCP_SERVER_NAME=mcp-atlassian
# Optional: override Cursor config location
CURSOR_MCP_CONFIG_PATH=

JIRA_BASE_URL=https://jira.telekom.de
JIRA_USER=you@example.com
JIRA_TOKEN=replace-me
# Alternative name some orgs use for Personal Access Tokens:
JIRA_PAT=
# Jira Server/Data Center often uses PAT as Bearer:
# - basic: Authorization: Basic base64(user:token_or_password)
# - bearer: Authorization: Bearer <token>
# If unset, this project defaults to bearer when `JIRA_PAT` is set, otherwise basic.
JIRA_AUTH_MODE=

# Optional
# Repo settings
REPO_ROOT=

OUTPUT_DIR=out
JIRA_API_VERSION=2
JIRA_VERIFY_SSL=true
HTTP_TIMEOUT_SECONDS=30

# Optional logs fetch (stub-friendly)
LOG_API_URL=
LOG_API_METHOD=GET
LOG_API_PARAM_NAME=ticket
LOG_API_VERIFY_SSL=
# Optional logs fallback folder (used if LOG_API_URL is unset/failed)
LOGS_DIR=

# Webhook server (FastAPI)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
# Safety gate: webhook requests with `?open=true` will only open Cursor if this is true.
WEBHOOK_ALLOW_OPEN=false

